# ─────────────────────────────────────────────────────────────
# Enterprise AI Gateway — environment template
# Copy to .env and fill in. NEVER commit the filled-in .env.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Model providers ──────────────────────────────────────────
# At least one is required. Missing keys make that provider
# fall back to the mock adapter (see gateway degraded mode).
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# ── Core ─────────────────────────────────────────────────────
# "development" relaxes API-key checks for ak_dev_* keys.
ENV=development

# Any SQLAlchemy URL. Defaults to local SQLite if unset.
DATABASE_URL=sqlite:///./ai_gateway.db

# Signing secret for user JWTs. Generate a fresh one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Public base URL of the gateway, used for OAuth callbacks
# and links in verification emails.
FRONTEND_URL=http://localhost:8000

# ── Google OAuth (optional) ──────────────────────────────────
# Leave blank to disable "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Transactional email (optional) ───────────────────────────
# Leave blank to disable verification / password-reset emails.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# ── Streamlit dashboard (dashboard/app.py only) ──────────────
GATEWAY_URL=http://localhost:8000
DASHBOARD_API_KEY=ak_dev_1234567890abcdef

# ── Offline mode (advanced) ──────────────────────────────────
# Set to 1 only when sentence-transformers models are already
# cached locally. If set on a fresh machine, the consensus
# arbiter and Prompt-DNA cache silently disable themselves.
# TRANSFORMERS_OFFLINE=0
# HF_DATASETS_OFFLINE=0
